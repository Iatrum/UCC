{
  "name": "emr-system",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run scripts/validate-env.ts && next build --webpack",
    "build:ci": "SKIP_ENV_VALIDATION=1 next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit -p tsconfig.lint.json && node scripts/check-clinic-admin-medplum.mjs",
    "lint:eslint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:all": "bun run lint && bun run lint:eslint",
    "test:unit": "bun test tests/unit",
    "validate-env": "bun run scripts/validate-env.ts",
    "test:e2e": "EMR_CLINIC_URL=https://demo.drhidayat.com EMR_ADMIN_URL=https://admin.iatrum.com bunx playwright test",
    "test:e2e:smoke": "EMR_CLINIC_URL=https://demo.drhidayat.com bunx playwright test --project=smoke",
    "test:e2e:clinic": "EMR_CLINIC_URL=https://demo.drhidayat.com bunx playwright test --project=clinic",
    "test:e2e:admin": "EMR_CLINIC_URL=https://demo.drhidayat.com EMR_ADMIN_URL=https://admin.iatrum.com bunx playwright test --project=admin",
    "cleanup:dev-seed": "rm -rf app/api/dev/seed tests/seeds/seed.ts",
    "medplum:setup-access": "bun run scripts/setup-access-policies.ts",
    "medplum:backfill-clinic-identifiers": "bun run scripts/backfill-clinic-identifiers.ts",
    "seed:procedures": "bun tsx tests/seeds/seed-procedures.ts",
    "seed": "bun tsx tests/seeds/seed.ts",
    "seed:patient": "bun run tests/seeds/seed-one-patient.mjs",
    "staging:preflight": "bun run scripts/staging/preflight.ts",
    "staging:seed": "bun run scripts/staging/seed.ts",
    "staging:up": "bash infra/staging/up.sh",
    "staging:down": "bash infra/staging/up.sh down",
    "staging:guard": "bash infra/staging/up.sh guard",
    "staging:probe": "bash scripts/staging/probe.sh",
    "staging:invite-rehearsal": "bash scripts/staging/rehearse-invite-dev.sh",
    "staging:audit": "bun run scripts/staging/audit-exposure.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@medplum/core": "^5.2.18",
    "@medplum/fhirtypes": "^5.2.18",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pako": "2.1.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "undici": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "baseline-browser-mapping": "^2.11.39",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@firebase/firestore>@grpc/grpc-js": "~1.9.16"
  }
}
