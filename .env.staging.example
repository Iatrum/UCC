# Template ONLY: placeholders, no secrets. Copy the NEXT block to the repo-root .env.staging.local
# (git-ignored) and fill it in. Never reuse a production value. Never commit a filled file.
# The generated infra file infra/staging/.env.staging.local (DB/Redis passwords) is created by infra/staging/up.sh.

# --- infra/staging (read by up.sh / docker compose) ---
MEDPLUM_IMAGE_TAG=REPLACE_WITH_PINNED_TAG_E_G_5.2.15

# --- UCC app (staging Next production build; NEXT_PUBLIC_* is inlined at build time) ---
MEDPLUM_BASE_URL=http://127.0.0.1:8123/
NEXT_PUBLIC_MEDPLUM_BASE_URL=http://127.0.0.1:8123/
NEXT_PUBLIC_MEDPLUM_PROJECT_ID=00000000-0000-0000-0000-000000000000
MEDPLUM_CLIENT_ID=REPLACE_staging_client_id
NEXT_PUBLIC_MEDPLUM_CLIENT_ID=REPLACE_staging_client_id
MEDPLUM_CLIENT_SECRET=REPLACE_staging_client_secret_min_20_chars
UCC_BASE_URL=http://127.0.0.1:3220
# Must NOT be .iatrum.com (production cookie domain). Leave empty/host-only for loopback.
COOKIE_DOMAIN=
NEXT_PUBLIC_BASE_DOMAIN=127.0.0.1

# --- Firebase: a SEPARATE staging project (Firestore drafts + Storage; Storage stays) ---
FIREBASE_PROJECT_ID=REPLACE_staging_firebase_project
FIREBASE_STORAGE_BUCKET=REPLACE_staging_firebase_project.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_staging_firebase_project.appspot.com
FIREBASE_CLIENT_EMAIL=REPLACE_staging_service_account_email
FIREBASE_PRIVATE_KEY=REPLACE_staging_private_key

# --- Staging safety guard (read by e2e/scripts/staging-preflight.ts) ---
UCC_STAGING_MEDPLUM_URL=http://127.0.0.1:8123/
UCC_STAGING_ALLOWED_FIREBASE_PROJECT=REPLACE_staging_firebase_project

# --- Next process limits ---
NODE_OPTIONS=--max-old-space-size=2048
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_generate_with_openssl_rand_base64_32
